doctype 5
html
  head
    meta charset='utf-8'
    title Nitrous Pro
    meta content='Nitrous Pro for Chrome' name='Author'
    link rel='stylesheet' href='/stylesheets/application.css'

    meta content=(config['app_name']) name='AppName'
    meta content=(config['app_version']) name='AppVersion'
    meta content=(config['host']) name='Host'
  body
    #splash
      .logo
      .version
        | Version #{config['app_version']}
    #login
      form
        .logo
        input type='text' name='login' placeholder='Username or Email' required=true
        input type='password' name='password' placeholder='Password' required=true
        input type='submit' value='Log In'
        .error
    #app
    script src='/javascripts/application.js'
